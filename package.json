{
  "name": "lughaty-oral-diagnostic",
  "version": "1.3.2",
  "description": "اختبار تشخيصي شفوي عربي للصفوف الأولية — لغتي الجميلة",
  "main": "main.js",
  "author": "محمد اللهيبي",
  "license": "MIT",
  "dependencies": {
    "pdfjs-dist": "4.10.38",
    "tesseract.js": "^6.0.1"
  },
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "prepack": "node scripts/third-party-notices.cjs",
    "predist": "node scripts/third-party-notices.cjs",
    "dist": "electron-builder --win nsis --publish never",
    "verify": "node --check main.js && node --check print-bridge.js",
    "test": "node smoke.cjs && node tests/print-ipc.cjs && node tests/profile-migration.cjs"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "sa.alluhaybi.lughatyoraldiagnostic",
    "productName": "Lughaty Oral Diagnostic",
    "artifactName": "Lughaty-Oral-Diagnostic-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "main.js",
      "print-bridge.js",
      "brand/**/*",
      "vendor/**/*",
      "package.json",
      "LICENSE",
      "PRIVACY.md",
      "profile-migration.js"
    ],
    "win": {
      "icon": "brand/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "الاختبار التشخيصي الشفوي - لغتي الجميلة",
      "perMachine": false,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "ar",
        "en_US"
      ]
    },
    "copyright": "Copyright © 2026 Mohammed Alluhaybi"
  }
}
