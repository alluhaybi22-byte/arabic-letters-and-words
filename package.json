{
  "name": "lughaty-oral-diagnostic",
  "version": "1.3.5",
  "description": "اختبار تشخيصي شفوي عربي للصفوف الأولية — لغتي الجميلة",
  "main": "main.js",
  "author": "محمد اللهيبي",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "6.8.9",
    "pdfjs-dist": "4.10.38",
    "tesseract.js": "^6.0.1"
  },
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "prepack": "node scripts/third-party-notices.cjs",
    "predist": "node scripts/third-party-notices.cjs",
    "dist": "electron-builder --win nsis --publish never",
    "verify": "node --check main.js && node --check renderer.js && node --check roster-import.js && node --check security-policy.js && node --check preview-storage.js && node --check print-bridge.js && node --check print-preview.js && node --check update-service.js",
    "test": "node smoke.cjs && node tests/print-ipc.cjs && node tests/profile-policy.cjs && node tests/update-service.cjs && node tests/security.cjs && node tests/pdf-import.cjs"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "sa.alluhaybi.lughatyoraldiagnostic",
    "productName": "Lughaty Oral Diagnostic",
    "artifactName": "Lughaty-Oral-Diagnostic-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "renderer.js",
      "roster-import.js",
      "security-policy.js",
      "preview-storage.js",
      "main.js",
      "print-bridge.js",
      "print-preview.js",
      "brand/**/*",
      "vendor/**/*",
      "package.json",
      "LICENSE",
      "PRIVACY.md",
      "profile-policy.js",
      "update-service.js"
    ],
    "win": {
      "icon": "brand/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "الاختبار التشخيصي الشفوي - لغتي الجميلة",
      "perMachine": false,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "ar",
        "en_US"
      ]
    },
    "copyright": "Copyright © 2026 Mohammed Alluhaybi",
    "publish": {
      "provider": "github",
      "owner": "alluhaybi22-byte",
      "repo": "arabic-letters-and-words",
      "releaseType": "release"
    }
  }
}
